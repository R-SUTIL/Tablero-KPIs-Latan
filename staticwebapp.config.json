{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.png",
      "*.webmanifest",
      "*.js",
      "*.json"
    ]
  },
  "routes": [
    {
      "route": "/service-worker.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
